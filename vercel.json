{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client/"
    },
    "server": {
      "root": "server/",
      "entrypoint": "src/index.ts"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": { "service": "server" }
    },
    {
      "source": "/((?!api).*)",
      "destination": { "service": "client" }
    }
  ]
}
